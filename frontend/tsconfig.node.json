{
  "compilerOptions": {
    // 增量构建缓存文件位置
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // 运行环境为 Node，使用较新的 ES 语法与能力
    "target": "es2023",
    "lib": ["ES2023"],
    // 引入 Node 类型（process、path 等）
    "types": ["node"],
    // 跳过第三方库的类型检查，提升构建速度
    "skipLibCheck": true,

    /* Bundler mode：面向打包工具（Vite）的模块设置 */
    "module": "nodenext",
    // 允许在导入时书写 .ts 后缀（Vite 支持）
    "allowImportingTsExtensions": true,
    // 强制使用 `import type` 导入纯类型，配合 isolatedModules 更安全
    "verbatimModuleSyntax": true,
    // 强制每个文件都是模块（避免全局脚本污染）
    "moduleDetection": "force",
    // 仅做类型检查，不产出 JS（实际构建由 Vite 完成）
    "noEmit": true,

    /* Linting：严格检查未使用变量、switch 穿透等 */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // 该配置只用于构建配置文件本身
  "include": ["vite.config.ts"]
}
