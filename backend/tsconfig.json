{
  "compilerOptions": {
    // 编译目标：ES2022（Node 18+ 已支持）
    "target": "ES2022", //编译后的 JavaScript 目标版本
    // 输出 ESM 模块（package.json 中 "type": "module"）
    "module": "ESNext",
    // 面向打包/现代 ESM 的模块解析策略
    "moduleResolution": "Bundler", //使用适合现代 ESM 工程的模块解析方式
    "rootDir": "./src", //源码目录
    "outDir": "./dist", //编译输出目录
    "strict": true, //开启 TypeScript 严格检查
    // 允许以 ES 模块方式默认导入 CommonJS 包（如 express）
    "esModuleInterop": true,
    // 文件名大小写敏感，避免跨平台（Windows/macOS）不一致
    "forceConsistentCasingInFileNames": true,
    // 跳过 node_modules 中第三方声明的类型检查，提升编译速度
    "skipLibCheck": true,
    // 生成 .d.ts 类型声明（便于被其他工程引用）
    "declaration": true,
    // 生成 sourcemap，便于线上堆栈映射到源码
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
