# ============================================================
# 环境变量示例文件
# ------------------------------------------------------------
# 使用方式：复制为 .env 后按本地环境填写（.env 已被 .gitignore 忽略）。
# 注意：.env 中包含密钥，切勿提交到仓库。
# ============================================================

# ===== 服务配置 =====
# HTTP 服务监听端口（需与前端 vite.config.ts 中的代理 target 保持一致）
PORT=3000
# 运行环境：development / production
NODE_ENV=development

# ===== MySQL 配置 =====
# 数据库主机
DB_HOST=localhost
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码（本地可为空）
DB_PASSWORD=
# 数据库名
DB_NAME=ai_assistant

# ===== DeepSeek 配置 =====
# API Key（必填，缺失时调用模型会报错）
DEEPSEEK_API_KEY=
# 接口基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 使用的模型名称
DEEPSEEK_MODEL=deepseek-flash
